{
  "name": "lantern-lan",
  "version": "0.1.0",
  "private": true,
  "description": "Lantern · 局域网聊天与文件管理",
  "author": "Lantern",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "check": "node scripts/check.cjs",
    "pack": "electron-builder --win portable --x64",
    "test:e2e": "node scripts/e2e.cjs",
    "pack:dir": "electron-builder --win --dir --x64"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "selfsigned": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.lantern.desktop",
    "productName": "Lantern",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "core/**",
      "ui/**",
      "package.json",
      "assets/**"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    }
  }
}
